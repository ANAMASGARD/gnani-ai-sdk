{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "tests/**/*.ts", "tsdown.config.ts"],
	"exclude": ["dist", "node_modules"]
}
