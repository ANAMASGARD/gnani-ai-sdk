{
	"name": "gnani",
	"version": "0.1.0",
	"description": "Unofficial community provider for Gnani Prisma transcription and Timbre speech in the Vercel AI SDK",
	"scripts": {
		"test": "vitest run",
		"dev": "tsdown --watch",
		"build": "tsdown",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"prepack": "npm run build",
		"test:live": "node scripts/verify-live.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ANAMASGARD/gnani-ai-sdk.git"
	},
	"keywords": [
		"ai-sdk",
		"gnani",
		"prisma",
		"timbre",
		"speech-to-text",
		"text-to-speech"
	],
	"type": "module",
	"bugs": {
		"url": "https://github.com/ANAMASGARD/gnani-ai-sdk/issues"
	},
	"homepage": "https://github.com/ANAMASGARD/gnani-ai-sdk#readme",
	"license": "MIT",
	"engines": {
		"node": ">=22.12.0"
	},
	"peerDependencies": {
		"ai": "^7.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"dependencies": {
		"@ai-sdk/provider": "^4.0.39",
		"@ai-sdk/provider-utils": "^5.0.83",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/node": "^26.6.6",
		"ai": "^7.0.180",
		"tsdown": "^0.23.7",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	}
}
